# ==============================================================================
# Kalka Co. Media Consultancy — Environment Variables Template
#
# IMPORTANT:
# - NEVER commit real credentials, API keys, or secrets to version control.
# - Phase 1 requires ZERO credentials.
# - Fill in values only when the active development phase explicitly requires them.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Analytics (Phase 9+ Google Analytics 4)
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------------------
# BACKEND (Node.js / Express.js)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kalka?retryWrites=true&w=majority

# Authentication (Google OAuth & Session Security)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=your_long_random_session_secret_min_32_chars
ADMIN_ALLOWED_EMAILS=admin@kalka.co,leadership@kalka.co

# Media Storage (Optional / Future Cloudinary integration)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Optional / Resend / SES / SendGrid)
# EMAIL_API_KEY=your_email_api_key
# EMAIL_FROM=Kalka Co. Media Consultancy <djdurgesh8@gmail.com>
# NOTIFICATION_RECEIVER_EMAIL=djdurgesh8@gmail.com
