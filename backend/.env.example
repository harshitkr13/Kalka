# ==============================================================================
# Kalka Co. Media Consultancy — Backend Environment Template
#
# IMPORTANT:
# - NEVER commit real credentials, API keys, or secrets to version control.
# - Phase 3 requires MONGODB_URI for database operations.
# - Fill in values locally only when developing with active database connectivity.
# ==============================================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=<YOUR_MONGODB_URI>
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000

# Google OAuth (Phase 4)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=<YOUR_SESSION_SECRET_MIN_32_CHARS>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Access Control (comma-separated Google emails authorized for admin access)
ADMIN_ALLOWED_EMAILS=admin@kalka.co,leadership@kalka.co

# Optional Email Dispatch (Resend / SendGrid / SES)
# EMAIL_API_KEY=
# EMAIL_FROM=Kalka Co. Media Consultancy <djdurgesh8@gmail.com>
# NOTIFICATION_RECEIVER_EMAIL=djdurgesh8@gmail.com
