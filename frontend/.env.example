# ==============================================================================
# Kalka Co. Media Consultancy — Frontend Environment Template
#
# IMPORTANT:
# - Set these environment variables in your deployment platform (e.g. Vercel).
# - NEVER put secret credentials into NEXT_PUBLIC_* variables.
# ==============================================================================

# Production API Endpoint (Target: https://api.kalka.co/api or backend deployment URL)
NEXT_PUBLIC_API_URL=https://api.kalka.co/api

# Optional: Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
